	<template>
		<name>Controller</name>
		<declaration>id_t listPlanes[N+1];
int[0,N] lenPlanes;


id_t listWaiting[N+1];
int[0,N] lenWaiting;

id_t freeingPlane;

// ------------------------------------------ Planes ------------------------------------------ 

void freeing(id_t plane)
{
    freeingPlane = plane;
}

// Put an element at the end of the queue
void enqueue(id_t plane)
{
    listPlanes[lenPlanes++] = plane;
}

// Remove the front element of the queue
void dequeue()
{
        int i = 0;
        int j = 0;

        lenPlanes -= 1;
        while (i &lt; lenPlanes)
        {
                listPlanes[i] = listPlanes[i + 1];
                i++;
        }
        listPlanes[i] = 0;
}


// Returns the front element of the queue
id_t front()
{
   return listPlanes[0];
}

// Returns the last element of the queue
id_t tail()
{

   return listPlanes[lenPlanes - 1];
}



void waiting(id_t plane)
{
    listWaiting[lenWaiting++] = plane;
}

void stopWaiting()
{
        int i = 0;
        int j = 0;

        lenWaiting -= 1;
        while (i &lt; lenWaiting)
        {
                listWaiting[i] = listWaiting[i + 1];
                i++;
        }
        listWaiting[i] = 0;
}

// Returns the front element of the queue
id_t front_waiting()
{
   return listWaiting[0];
}

// Returns the last element of the queue
id_t tail_waiting()
{

   return listWaiting[lenWaiting - 1];
}
