		<parameter>const id_r id</parameter>
		<declaration>clock t;
id_t planeUsing;

// Plane uses the runway
void use(id_t plane, id_r runway)
{
    listRunways[runway] = true;
    planeUsing = plane;
}

// Plane leaves the runway
void leave(id_r runway)
{
    listRunways[runway] = false;
    planeUsing = 0;
    
}
